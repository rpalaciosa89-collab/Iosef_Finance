# ============================================================
# Iosef Finance — Configuración de Entorno
# Copia este archivo como .env y completa los valores reales
# ============================================================

# --- DeepSeek API (obtén tu key en https://platform.deepseek.com) ---
# URL base sin /v1 — el cliente agrega /chat/completions automáticamente
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-tu-api-key-real-aqui
DEEPSEEK_MODEL=deepseek-chat

# Control de costos (opcionales, estos son los defaults)
DEEPSEEK_MAX_TOKENS=512       # ↓ más bajo = más barato
DEEPSEEK_TEMPERATURE=0.1      # 0.0 = determinista, 0.7 = creativo
DEEPSEEK_USE_CACHE=true       # true = evita llamadas duplicadas
DEEPSEEK_TIMEOUT=30           # segundos

# --- Redis (instalar con: brew install redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Base de datos ---
DATABASE_URL=sqlite:///../data/iosef_finance.db

# --- Seguridad ---
SECRET_KEY=cambia_esto_por_una_clave_segura
